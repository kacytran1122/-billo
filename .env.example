# Billo · environment variables
# Copy to .env (cp .env.example .env) and fill in. NEVER commit .env.
# Every service reads this one file from the repo root.

# ---------- Mode ----------
# demo = use synthetic data + mocks where a key is missing (safe for the stage)
# live = call the real APIs
BILLO_MODE=demo

# ---------- Fetch.ai (agents) ----------
# ASI:One API key: https://asi1.ai/developer  (OpenAI-compatible endpoint)
ASI_ONE_API_KEY=
ASI_ONE_BASE_URL=https://api.asi1.ai/v1
ASI_ONE_MODEL=asi1
# One unique, secret seed phrase per agent. Changing a seed changes the agent address.
SEED_COORDINATOR=billo-coordinator-CHANGE-ME-long-random-words
SEED_RED_FLAG=billo-red-flag-CHANGE-ME-long-random-words
SEED_CARE_FINDER=billo-care-finder-CHANGE-ME-long-random-words
SEED_BILL_AUDITOR=billo-bill-auditor-CHANGE-ME-long-random-words
# Compatibility name: this seed now runs the Care Settlement Router.
SEED_PAYMENT_GUARD=billo-care-settlement-router-CHANGE-ME-long-random-words
SEED_GATEWAY=billo-imessage-gateway-CHANGE-ME-long-random-words
SEED_CASE_MEDIC=billo-case-medic-CHANGE-ME-long-random-words
# Filled in after the first run (each agent prints its address). The Coordinator needs these.
ADDR_RED_FLAG=
ADDR_CARE_FINDER=
ADDR_BILL_AUDITOR=
ADDR_PAYMENT_GUARD=
ADDR_GATEWAY=
ADDR_COORDINATOR=
ADDR_CASE_MEDIC=

# ---------- Core API (FastAPI) ----------
CORE_URL=http://localhost:8000
# Public base URL for case pages and QR images (deploy target)
PUBLIC_BASE_URL=https://heybillo.tech
# Hostname served by Caddy on the Oracle VM (hostname only, no https://)
BILLO_DOMAIN=api.heybillo.tech
# Vision model for reading bill photos (any OpenAI-compatible vision model)
VISION_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
VISION_MODEL=gpt-4o-mini
OCR_MIN_CONFIDENCE=0.6
OCR_MIN_LINES=1
OCR_MAX_IMAGE_BYTES=20971520
# Writable temporary directory. Uploaded bill images are deleted after extraction.
BILLO_UPLOADS_DIR=backend/api/uploads

# ---------- Tiger Data [MLH] (TimescaleDB on Tiger Cloud) ----------
DATABASE_URL=postgres://tsdbadmin:PASSWORD@HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require

# ---------- Photon (iMessage via Spectrum) ----------
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# The iMessage address patients text (E.164 phone or email), provisioned by Photon
PHOTON_LINE_ADDRESS=
BRIDGE_PORT=3000
BRIDGE_URL=http://localhost:3000
# REST endpoint of the iMessage Gateway uAgent (its port)
GATEWAY_URL=http://localhost:8006
# Shared secret between bridge <-> gateway <-> core
# Required and must not be dev-token when BILLO_MODE=live.
INTERNAL_TOKEN=change-me-random-string

# ---------- Sentry ----------
SENTRY_DSN=
SENTRY_ENVIRONMENT=hackathon
# For Case Medic to read traces through the Sentry API (scope: event:read, project:read)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
# Key for the keyed hash (HMAC) of case IDs in Sentry
CASE_HASH_KEY=change-me-random-string
# Internal Integration Client Secret used to verify Sentry-Hook-Signature.
# Required when BILLO_MODE=live and SENTRY_DSN is set.
SENTRY_WEBHOOK_SECRET=
# Public or private URL where Core can reach the Case Medic REST endpoint.
CASE_MEDIC_URL=http://localhost:8007
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILE_SESSION_SAMPLE_RATE=1.0
SENTRY_API_URL=https://sentry.io

# ---------- Visa settlement routing ----------
# simulate is the only executable mode. It validates and records the flow but never moves money.
VISA_QR_MODE=simulate
VISA_DIRECT_MODE=simulate

# ---------- NPI Registry ----------
# live = call https://npiregistry.cms.hhs.gov, demo = accept the demo NPIs in data/synthetic
NPI_MODE=demo

# ---------- Timing ----------
# Minutes after the visit time before Billo asks "Did you go?" (30 in real life, 1 for the demo)
FOLLOWUP_MINUTES=1
